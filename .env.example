DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-secret-e-g-openssl-rand-base64-32"
EMPTY_USER_PASSWORD="optional-initial-password-for-empty-user"
DEMO_USER_PASSWORD="optional-initial-password-for-demo-user"

# Cloudflare R2 (S3-Compatible CDN Media Storage)
CLOUDFLARE_R2_ACCESS_KEY="your-cloudflare-r2-access-key-id"
CLOUDFLARE_R2_SECRET_KEY="your-cloudflare-r2-secret-access-key"
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_BUCKET_NAME="your-r2-bucket-name"
CLOUDFLARE_R2_PUBLIC_URL="https://your-public-r2-domain-or-custom-domain.com"

# AI Hook Breakdown — provider: "deepseek" | "openrouter" (default: deepseek)
API_PROVIDER="deepseek"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_TEXT_MODEL="deepseek-chat"
DEEPSEEK_VISION_MODEL="deepseek-v4-flash-vision-exp"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_TEXT_MODEL="deepseek/deepseek-v4-flash"
OPENROUTER_VISION_MODEL="meta-llama/llama-4-maverick:free"
